APP_NAME="TakeYourGoods AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://takeyoursgoods.co.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=sync
CACHE_STORE=database

# Hostinger SMTP Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@takeyoursgoods.co.uk
MAIL_PASSWORD=your_hostinger_email_password_here
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@takeyoursgoods.co.uk"
MAIL_FROM_NAME="TakeYourGoods AI"

# UK Company Requisites (COLCHESTER LTD)
COMPANY_NAME="COLCHESTER LTD"
COMPANY_NUMBER="16113808"
COMPANY_ADDRESS="Dept 6898 126 East Ferry Road, Canary Wharf, London, England, E14 9FP"
COMPANY_EMAIL="info@takeyoursgoods.co.uk"

# AI Sourcing Engine API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

VITE_APP_NAME="${APP_NAME}"


